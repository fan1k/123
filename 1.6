function generate(numRows) {
    let triangle = [];

    for (let row = 0; row < numRows; row++) {
        let newRow = Array(row + 1).fill(1);

        for (let j = 1; j < row; j++) {
            newRow[j] = triangle[row - 1][j - 1] + triangle[row - 1][j];
        }

        triangle.push(newRow);
    }

    return triangle;
}
