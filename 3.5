const readline = require("readline");

const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout,
});

rl.on("line", (line) => {
    const stack = [];
    const pairs = {
        "(": ")",
        "[": "]",
        "{": "}",
    };

    let isValid = true;

    for (let char of line) {
        if (char === "(" || char === "[" || char === "{") {
            stack.push(char);
        } else if (char === ")" || char === "]" || char === "}") {
            if (stack.length === 0) {
                isValid = false;
                break;
            }
            const top = stack.pop();
            if (pairs[top] !== char) {
                isValid = false;
                break;
            }
        }
    }

    if (stack.length > 0) {
        isValid = false;
    }

    console.log(isValid ? "yes" : "no");

    rl.close();
});
