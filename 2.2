function mySqrt(x) {
    if (x === 0 || x === 1) {
        return x;
    }

    let low = 0;
    let high = x;

    while (low <= high) {
        let mid = Math.floor((low + high) / 2);
        let midSquared = mid * mid;

        if (midSquared === x) {
            return mid;
        } else if (midSquared < x) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }

    return high;
}
